use Illuminate\Http\Request;
use App\Models\Movie;
use App\Models\Actor;

class MovieController extends Controller
{
    // แสดงข้อมูลภาพยนตร์
    public function index()
    {
        $movies = Movie::with('actor')->get();

        return view('movies.index', compact('movies'));
