namespace App\Http\Controllers;

use App\Models\Teacher;
use App\Models\Schedule;
use Illuminate\Http\Request;

class ScheduleController extends Controller
{
    public function index(Request $request)
    {
        $viewType = $request->input('type', 'teacher'); // ดูตาม 'teacher' หรือ 'classroom'
        $teachers = Teacher::all();
        $classrooms = ['ม.1', 'ม.2', 'ม.3', 'ม.4', 'ม.5', 'ม.6'];
        $days = ['จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์'];

        $selectedTeacherId = $request->input('teacher_id', $teachers->first()?->id);
        $selectedClassroom = $request->input('classroom', 'ม.1');

        $query = Schedule::with('teacher');

        if ($viewType === 'classroom') {
            $query->where('classroom', $selectedClassroom);
        } else {
            if ($selectedTeacherId) {
                $query->where('teacher_id', $selectedTeacherId);
            }
        }

        $schedules = $query->get();

        // จัดโครงสร้างข้อมูลลง Matrix [วัน][คาบ]
        $timetable = [];
        foreach ($days as $day) {
            for ($period = 1; $period <= 6; $period++) {
                $timetable[$day][$period] = null;
            }
        }

        foreach ($schedules as $item) {
            $timetable[$item->day_of_week][$item->period] = $item;
        }

        return view('dashboard.schedules', compact(
            'viewType',
            'teachers',
            'classrooms',
            'days',
            'selectedTeacherId',
            'selectedClassroom',
            'timetable'
        ));
    }
}
