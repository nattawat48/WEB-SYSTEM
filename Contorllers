namespace App\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Models\Teacher;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\File;

class TeacherController extends Controller
{
    public function index(Request $request)
    {
        $selectedLevel = $request->input('level', 'all');

        $query = Teacher::query();
        
        // กรองเฉพาะเมื่อไม่ได้เลือก 'all'
        if ($selectedLevel !== 'all' && !empty($selectedLevel)) {
            $query->where('classroom_advisor', $selectedLevel);
        }

        $teachers = $query->latest()->get();

        $editTeacher = null;
        if ($request->filled('edit')) {
            $editTeacher = Teacher::find($request->edit);
        }

        return view('dashboard.teachers', compact('teachers', 'selectedLevel', 'editTeacher'));
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'name' => 'required|string|max:255',
            'subject' => 'required|string|max:255',
            'classroom_advisor' => 'required|string',
            'phone' => 'nullable|string|max:20',
            'image' => 'nullable|image|mimes:jpeg,png,jpg|max:2048',
        ]);

        if ($request->hasFile('image')) {
            $uploadPath = public_path('uploads/teachers');
            if (!File::isDirectory($uploadPath)) {
                File::makeDirectory($uploadPath, 0755, true, true);
            }

            $imageName = time() . '_' . uniqid() . '.' . $request->image->extension();
            $request->image->move($uploadPath, $imageName);
            $data['image'] = 'uploads/teachers/' . $imageName;
        }

        Teacher::create($data);

        // ส่งกลับไปยังแท็บ 'all' หรือแท็บของห้องที่เพิ่งเพิ่ม เพื่อให้เห็นข้อมูลทันที
        return redirect()->route('teachers.index', ['level' => 'all'])
            ->with('success', 'เพิ่มข้อมูลคุณครูเรียบร้อยแล้ว');
    }

    public function update(Request $request, $id)
    {
        $teacher = Teacher::findOrFail($id);

        $data = $request->validate([
            'name' => 'required|string|max:255',
            'subject' => 'required|string|max:255',
            'classroom_advisor' => 'required|string',
            'phone' => 'nullable|string|max:20',
            'image' => 'nullable|image|mimes:jpeg,png,jpg|max:100240',
        ], [
            'image.max' => 'ขนาดไฟล์รูปภาพต้องไม่เกิน 10 MB',
            'image.image' => 'ไฟล์ที่อัปโหลดต้องเป็นรูปภาพเท่านั้น',
            'image.mimes' => 'รองรับเฉพาะไฟล์ประเภท jpeg, png, jpg',
        ]);

        if ($request->hasFile('image')) {
            if ($teacher->image && File::exists(public_path($teacher->image))) {
                File::delete(public_path($teacher->image));
            }

            $uploadPath = public_path('uploads/teachers');
            if (!File::isDirectory($uploadPath)) {
                File::makeDirectory($uploadPath, 0755, true, true);
            }

            $imageName = time() . '_' . uniqid() . '.' . $request->image->extension();
            $request->image->move($uploadPath, $imageName);
            $data['image'] = 'uploads/teachers/' . $imageName;
        }

        $teacher->update($data);

        return redirect()->route('teachers.index', ['level' => 'all'])
            ->with('success', 'แก้ไขข้อมูลคุณครูเรียบร้อยแล้ว');
    }

    public function destroy($id)
    {
        $teacher = Teacher::findOrFail($id);

        if ($teacher->image && File::exists(public_path($teacher->image))) {
            File::delete(public_path($teacher->image));
        }

        $teacher->delete();

        return redirect()->route('teachers.index')
            ->with('success', 'ลบข้อมูลคุณครูเรียบร้อยแล้ว');
    }
}
