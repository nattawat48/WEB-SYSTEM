namespace App\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Models\Grade;
use App\Models\Student;
use Illuminate\Http\Request;

class AcademicEvaluationController extends Controller
{
    public function index(Request $request)
    {
        // 1. ดึงรายชื่อห้องเรียนทั้งหมดที่มีนักเรียน
        $classrooms = Student::select('classroom')
            ->distinct()
            ->orderBy('classroom')
            ->pluck('classroom');

        // 2. เลือกห้องเรียนปัจจุบัน (ถ้าไม่มี ให้เลือกห้องแรกอัตโนมัติ)
        $selectedClassroom = $request->input('classroom', $classrooms->first());

        // 3. ดึงนักเรียนเฉพาะในห้องเรียนที่เลือก พร้อมคะแนนทุกวิชา
        $students = collect();
        if ($selectedClassroom) {
            $students = Student::with('grades')
                ->where('classroom', $selectedClassroom)
                ->orderBy('code')
                ->get();
        }

        // 4. ตรวจสอบการเลือกนักเรียนคนใดคนหนึ่ง
        $selectedStudent = null;
        if ($request->filled('student_id')) {
            $selectedStudent = Student::with('grades')->find($request->student_id);
        }

        // 5. ตรวจสอบการกดแก้ไขคะแนน
        $editGrade = null;
        if ($request->filled('edit_grade_id')) {
            $editGrade = Grade::find($request->edit_grade_id);
            if ($editGrade && !$selectedStudent) {
                $selectedStudent = Student::with('grades')->find($editGrade->student_id);
            }
        }

        return view('dashboard.index', compact('students', 'classrooms', 'selectedClassroom', 'selectedStudent', 'editGrade'));
    }

    private function calculateGrade($score)
    {
        $score = (float) $score;
        if ($score >= 80) return '4.0';
        elseif ($score >= 75) return '3.5';
        elseif ($score >= 70) return '3.0';
        elseif ($score >= 65) return '2.5';
        elseif ($score >= 60) return '2.0';
        elseif ($score >= 55) return '1.5';
        elseif ($score >= 50) return '1.0';
        else return '0.0';
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'student_id' => 'required|exists:students,id',
            'subject'    => 'required|string|max:255',
            'score'      => 'required|numeric|min:0|max:100',
        ]);

        $data['grade'] = $this->calculateGrade($data['score']);
        Grade::create($data);

        $student = Student::find($data['student_id']);

        return redirect()->route('grades.index', [
            'classroom'  => $student->classroom ?? null,
            'student_id' => $data['student_id'],
        ])->with('success', 'บันทึกเกรดวิชาใหม่เรียบร้อยแล้ว (เกรด: ' . $data['grade'] . ')');
    }

    public function update(Request $request, $id)
    {
        $gradeRecord = Grade::findOrFail($id);

        $data = $request->validate([
            'subject' => 'required|string|max:255',
            'score'   => 'required|numeric|min:0|max:100',
        ]);

        $data['grade'] = $this->calculateGrade($data['score']);
        $gradeRecord->update($data);

        $student = Student::find($gradeRecord->student_id);

        return redirect()->route('grades.index', [
            'classroom'  => $student->classroom ?? null,
            'student_id' => $gradeRecord->student_id,
        ])->with('success', 'แก้ไขผลการเรียนเรียบร้อยแล้ว (เกรด: ' . $data['grade'] . ')');
    }

    public function destroy($id)
    {
        $grade = Grade::findOrFail($id);
        $student = Student::find($grade->student_id);
        $studentId = $grade->student_id;
        $grade->delete();

        return redirect()->route('grades.index', [
            'classroom'  => $student->classroom ?? null,
            'student_id' => $studentId,
        ])->with('success', 'ลบรายการผลการเรียนสำเร็จ');
    }
}
