namespace App\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Models\Attendance;
use App\Models\Student;
use Illuminate\Http\Request;

class ClassAttendanceController extends Controller
{
    public function index(Request $request)
    {
        $date = $request->input('date', now()->toDateString());

        // 1. ดึงรายชื่อห้องเรียนทั้งหมดที่มีนักเรียนอยู่
        $classrooms = Student::select('classroom')
            ->distinct()
            ->orderBy('classroom')
            ->pluck('classroom');

        // 2. เลือกห้องเรียนปัจจุบัน (ถ้าไม่มีการระบุ ให้เลือกห้องแรกอัตโนมัติ ไม่มีการแสดงรวมทั้งหมด)
        $selectedClassroom = $request->input('classroom', $classrooms->first());

        // 3. ดึงนักเรียนเฉพาะห้องเรียนที่เลือกเท่านั้น
        $students = collect();
        if ($selectedClassroom) {
            $students = Student::where('classroom', $selectedClassroom)
                ->orderBy('code')
                ->get();
        }

        // 4. ดึงข้อมูลการเช็กชื่อของวันและห้องนั้นๆ
        $attendances = Attendance::where('date', $date)->get()->keyBy('student_id');

        $records = $students->map(function ($student) use ($attendances) {
            $att = $attendances->get($student->id);
            return [
                'attendance_id' => $att ? $att->id : null,
                'student_id'    => $student->id,
                'code'          => $student->code ?? '-',
                'name'          => $student->name ?? '-',
                'classroom'     => $student->classroom ?? '-',
                'status'        => $att ? $att->status : 'มาเรียน',
                'remark'        => $att ? $att->remark : '',
            ];
        });

        // สรุปยอด มา/สาย/ขาด/ลา ประจำห้องนั้น
        $roomSummary = [
            'total'   => $records->count(),
            'present' => $records->where('status', 'มาเรียน')->count(),
            'late'    => $records->where('status', 'สาย')->count(),
            'absent'  => $records->filter(fn($r) => in_array($r['status'], ['ขาด', 'ขาดเรียน']))->count(),
            'leave'   => $records->where('status', 'ลา')->count(),
        ];

        return view('dashboard.index', compact('records', 'classrooms', 'selectedClassroom', 'date', 'roomSummary'));
    }

    public function store(Request $request)
    {
        $request->validate([
            'date'               => 'required|date',
            'attendances'        => 'required|array',
            'selected_classroom' => 'required|string',
        ]);

        $date = $request->input('date');

        foreach ($request->input('attendances') as $studentId => $item) {
            Attendance::updateOrCreate(
                [
                    'student_id' => $studentId,
                    'date'       => $date,
                ],
                [
                    'status' => $item['status'] ?? 'มาเรียน',
                    'remark' => $item['remark'] ?? null,
                ]
            );
        }

        return redirect()->route('attendance.index', [
            'date'      => $date,
            'classroom' => $request->input('selected_classroom'),
        ])->with('success', 'บันทึกการเช็กชื่อห้อง ' . $request->input('selected_classroom') . ' เรียบร้อยแล้ว');
    }

    public function destroy($id)
    {
        $attendance = Attendance::findOrFail($id);
        $date = $attendance->date;
        $classroom = $attendance->student->classroom ?? null;
        $attendance->delete();

        return redirect()->route('attendance.index', ['date' => $date, 'classroom' => $classroom])
            ->with('success', 'ลบประวัติการเข้าเรียนเรียบร้อยแล้ว');
    }
}
