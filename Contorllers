namespace App\Http\Controllers;

use App\Models\Student;
use App\Models\Attendance;
use App\Models\Grade;
use Illuminate\Http\Request;
use Carbon\Carbon;

class ReportController extends Controller
{
    public function index(Request $request)
    {
        $classrooms = Student::select('classroom')->distinct()->orderBy('classroom')->pluck('classroom');
        $selectedClassroom = $request->input('classroom', $classrooms->first() ?? 'ม.1');
        $selectedMonth = $request->input('month', now()->format('Y-m'));

        $students = Student::with('grades')
            ->where('classroom', $selectedClassroom)
            ->orderBy('code')
            ->get();

        return view('dashboard.reports', compact('classrooms', 'selectedClassroom', 'selectedMonth', 'students'));
    }

    // 1. แบบรายงานผลการพัฒนาคุณภาพผู้เรียน (ปพ.5 - รายห้อง)
    public function exportPp5(Request $request)
    {
        $classroom = $request->input('classroom');
        $students = Student::with('grades')
            ->where('classroom', $classroom)
            ->orderBy('code')
            ->get();

        return view('dashboard.reports_pp5', compact('classroom', 'students'));
    }

    // 2. แบบรายงานผลการเรียนรายบุคคล (ปพ.6 - รายบุคคล)
    public function exportPp6($studentId)
    {
        $student = Student::with('grades')->findOrFail($studentId);
        $gpa = $student->grades->count() > 0 ? number_format($student->grades->avg('grade'), 2) : '0.00';

        return view('dashboard.reports_pp6', compact('student', 'gpa'));
    }

    // 3. สรุปสถิติการมาเรียนประจำเดือน (ขาด ลา มา สาย)
    public function exportMonthlyAttendance(Request $request)
    {
        $classroom = $request->input('classroom');
        $month = $request->input('month', now()->format('Y-m')); // Format: YYYY-MM
        $monthDate = Carbon::createFromFormat('Y-m', $month);

        $students = Student::where('classroom', $classroom)->orderBy('code')->get();

        // คำนวณสถิติของนักเรียนแต่ละคนในเดือนนั้น
        $attendanceSummary = [];
        foreach ($students as $student) {
            $records = Attendance::where('student_id', $student->id)
                ->whereYear('date', $monthDate->year)
                ->whereMonth('date', $monthDate->month)
                ->get();

            $attendanceSummary[$student->id] = [
                'student' => $student,
                'present' => $records->where('status', 'มาเรียน')->count(),
                'late'    => $records->where('status', 'สาย')->count(),
                'absent'  => $records->whereIn('status', ['ขาด', 'ขาดเรียน'])->count(),
                'leave'   => $records->where('status', 'ลา')->count(),
                'total_days' => $records->count(),
            ];
        }

        return view('dashboard.reports_monthly_attendance', compact('classroom', 'monthDate', 'attendanceSummary'));
    }
}
