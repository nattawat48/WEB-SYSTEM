    {
        $actors = Actor::all();

        return view('movies.create', compact('actors'));
    }

    // บันทึกข้อมูลใหม่
    public function store(Request $request)
    {
        Movie::create([
            'title' => $request->title,
            'release_year' => $request->release_year,
            'actor_id' => $request->actor_id ?: null,
        ]);

        return redirect()->route('movie.index');
    }

    // หน้าแก้ไขข้อมูล
